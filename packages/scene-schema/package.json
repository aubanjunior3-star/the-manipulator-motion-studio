{
  "name": "@manipulator/scene-schema",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Schéma MSD côté TypeScript : types générés, registre, validation structurelle.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
